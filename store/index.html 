<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Netsorna — Handcrafted Leather Goods</title>
  <meta name="description" content="Premium handcrafted leather bags, wallets, and accessories. Made to order with care.">
  <link rel="stylesheet" href="css/tokens.css">
  <link rel="stylesheet" href="css/reset.css">
  <link rel="stylesheet" href="css/base.css">
  <style>
    /* ==========================================
       INDEX PAGE — HOME
       ========================================== */

    /* Hero */
    .hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: var(--space-24) var(--page-padding-x);
      background: linear-gradient(135deg, var(--bg-body) 0%, var(--bg-surface-alt) 100%);
      overflow: hidden;
    }

    .hero__bg {
      position: absolute;
      inset: 0;
      opacity: 0.06;
      background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23000000' fill-opacity='1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }

    .hero__content {
      position: relative;
      z-index: 1;
      max-width: 720px;
    }

    .hero__eyebrow {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      font-weight: var(--font-medium);
      letter-spacing: var(--tracking-widest);
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: var(--space-4);
    }

    .hero__title {
      font-family: var(--font-secondary);
      font-size: var(--text-5xl);
      font-weight: var(--font-bold);
      line-height: var(--leading-tight);
      color: var(--text-primary);
      margin-bottom: var(--space-6);
    }

    .hero__title .accent {
      font-family: var(--font-signature);
      font-weight: var(--font-regular);
      color: var(--accent-custom-order);
    }

    .hero__subtitle {
      font-size: var(--text-lg);
      color: var(--text-muted);
      line-height: var(--leading-relaxed);
      margin-bottom: var(--space-10);
      max-width: 520px;
      margin-left: auto;
      margin-right: auto;
    }

    .hero__cta {
      display: flex;
      gap: var(--space-4);
      justify-content: center;
      flex-wrap: wrap;
    }

    .hero__scroll {
      position: absolute;
      bottom: var(--space-12);
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-2);
      color: var(--text-muted);
      font-size: var(--text-xs);
      font-family: var(--font-mono);
      letter-spacing: var(--tracking-wider);
      text-transform: uppercase;
      animation: bounce 2s ease-in-out infinite;
    }

    @keyframes bounce {
      0%, 100% { transform: translateX(-50%) translateY(0); }
      50% { transform: translateX(-50%) translateY(8px); }
    }

    /* Featured Products */
    .featured {
      padding: var(--section-gap) 0;
    }

    .section-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      margin-bottom: var(--space-12);
      padding: 0 var(--page-padding-x);
    }

    .section-header__title {
      font-family: var(--font-secondary);
      font-size: var(--text-3xl);
      font-weight: var(--font-bold);
      color: var(--text-primary);
    }

    .section-header__link {
      font-size: var(--text-sm);
      font-weight: var(--font-medium);
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: var(--space-2);
      transition: color var(--duration-fast) var(--ease-smooth);
    }

    .section-header__link:hover {
      color: var(--text-primary);
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--grid-gutter);
      padding: 0 var(--page-padding-x);
    }

    @media (min-width: 640px) {
      .product-grid { grid-template-columns: repeat(3, 1fr); }
    }

    @media (min-width: 1024px) {
      .product-grid { grid-template-columns: repeat(4, 1fr); }
    }

    .product-card {
      background: var(--bg-surface);
      border-radius: var(--radius-lg);
      overflow: hidden;
      transition: transform var(--duration-base) var(--ease-smooth), box-shadow var(--duration-base) var(--ease-smooth);
    }

    .product-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-card-hover);
    }

    .product-card__media {
      position: relative;
      aspect-ratio: 3 / 4;
      background: var(--hero-fallback);
      overflow: hidden;
    }

    .product-card__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform var(--duration-slow) var(--ease-smooth);
    }

    .product-card:hover .product-card__media img {
      transform: scale(1.05);
    }

    .product-card__badge {
      position: absolute;
      top: var(--space-3);
      left: var(--space-3);
    }

    .product-card__content {
      padding: var(--space-5);
    }

    .product-card__category {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: var(--tracking-wider);
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: var(--space-2);
    }

    .product-card__name {
      font-size: var(--text-base);
      font-weight: var(--font-semibold);
      color: var(--text-primary);
      margin-bottom: var(--space-3);
      line-height: var(--leading-snug);
    }

    .product-card__footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .product-card__price {
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      font-weight: var(--font-semibold);
      color: var(--price-color);
    }

    .product-card__price--sale {
      color: var(--price-sale);
    }

    .product-card__price--original {
      text-decoration: line-through;
      color: var(--price-original);
      font-weight: var(--font-regular);
      margin-left: var(--space-2);
    }

    /* Brand Story */
    .brand-story {
      padding: var(--section-gap) var(--page-padding-x);
      background: var(--bg-surface-alt);
    }

    .brand-story__inner {
      max-width: var(--content-max-width);
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-16);
      align-items: center;
    }

    @media (min-width: 1024px) {
      .brand-story__inner { grid-template-columns: 1fr 1fr; }
    }

    .brand-story__media {
      position: relative;
      aspect-ratio: 4 / 3;
      border-radius: var(--radius-xl);
      overflow: hidden;
      background: var(--hero-fallback);
    }

    .brand-story__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .brand-story__content {
      max-width: 480px;
    }

    .brand-story__eyebrow {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: var(--tracking-widest);
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: var(--space-4);
    }

    .brand-story__title {
      font-family: var(--font-secondary);
      font-size: var(--text-3xl);
      font-weight: var(--font-bold);
      color: var(--text-primary);
      margin-bottom: var(--space-6);
      line-height: var(--leading-tight);
    }

    .brand-story__text {
      font-size: var(--text-base);
      color: var(--text-muted);
      line-height: var(--leading-relaxed);
      margin-bottom: var(--space-8);
    }

    /* Values */
    .values {
      padding: var(--section-gap) var(--page-padding-x);
    }

    .values__grid {
      max-width: var(--content-max-width);
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8);
    }

    @media (min-width: 768px) {
      .values__grid { grid-template-columns: repeat(4, 1fr); }
    }

    .value-item {
      text-align: center;
      padding: var(--space-8) var(--space-6);
    }

    .value-item__icon {
      width: 48px;
      height: 48px;
      margin: 0 auto var(--space-5);
      color: var(--text-primary);
    }

    .value-item__title {
      font-size: var(--text-base);
      font-weight: var(--font-semibold);
      color: var(--text-primary);
      margin-bottom: var(--space-2);
    }

    .value-item__desc {
      font-size: var(--text-sm);
      color: var(--text-muted);
      line-height: var(--leading-relaxed);
    }

    /* Newsletter */
    .newsletter {
      padding: var(--section-gap) var(--page-padding-x);
      background: var(--bg-surface);
      border-top: var(--border-default) solid var(--border-light);
    }

    .newsletter__inner {
      max-width: 560px;
      margin: 0 auto;
      text-align: center;
    }

    .newsletter__title {
      font-family: var(--font-secondary);
      font-size: var(--text-2xl);
      font-weight: var(--font-bold);
      color: var(--text-primary);
      margin-bottom: var(--space-4);
    }

    .newsletter__text {
      font-size: var(--text-base);
      color: var(--text-muted);
      margin-bottom: var(--space-8);
      line-height: var(--leading-relaxed);
    }

    .newsletter__form {
      display: flex;
      gap: var(--space-3);
    }

    .newsletter__form .input {
      flex: 1;
    }

    /* Footer */
    .footer {
      padding: var(--space-16) var(--page-padding-x) var(--space-8);
      background: var(--bg-surface);
      border-top: var(--border-default) solid var(--border-light);
    }

    .footer__inner {
      max-width: var(--content-max-width);
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-12);
    }

    @media (min-width: 768px) {
      .footer__inner { grid-template-columns: 2fr 1fr 1fr 1fr; }
    }

    .footer__brand {
      font-family: var(--font-secondary);
      font-size: var(--text-xl);
      font-weight: var(--font-bold);
      color: var(--text-primary);
      margin-bottom: var(--space-4);
    }

    .footer__tagline {
      font-size: var(--text-sm);
      color: var(--text-muted);
      line-height: var(--leading-relaxed);
      max-width: 280px;
    }

    .footer__heading {
      font-size: var(--text-sm);
      font-weight: var(--font-semibold);
      color: var(--text-primary);
      margin-bottom: var(--space-5);
      letter-spacing: var(--tracking-wide);
      text-transform: uppercase;
    }

    .footer__links {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }

    .footer__link {
      font-size: var(--text-sm);
      color: var(--text-muted);
      transition: color var(--duration-fast) var(--ease-smooth);
    }

    .footer__link:hover {
      color: var(--text-primary);
    }

    .footer__bottom {
      max-width: var(--content-max-width);
      margin: var(--space-12) auto 0;
      padding-top: var(--space-8);
      border-top: var(--border-default) solid var(--border-light);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: var(--space-4);
    }

    .footer__copyright {
      font-size: var(--text-xs);
      color: var(--text-placeholder);
    }

    .footer__socials {
      display: flex;
      gap: var(--space-4);
    }

    .footer__social {
      width: 20px;
      height: 20px;
      color: var(--text-muted);
      transition: color var(--duration-fast) var(--ease-smooth);
    }

    .footer__social:hover {
      color: var(--text-primary);
    }
  </style>
</head>
