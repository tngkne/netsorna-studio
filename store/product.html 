  <script>
    function selectVariant(btn, labelId) {
      const group = btn.closest('.variant-options');
      group.querySelectorAll('.variant-option').forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const label = document.getElementById(labelId);
      if (btn.dataset.color) label.textContent = btn.dataset.color;
      else label.textContent = btn.textContent;
    }

    function adjustQty(delta) {
      const input = document.getElementById('qty');
      const val = parseInt(input.value) + delta;
      if (val >= 1 && val <= 10) input.value = val;
    }

    // Tab switching
    document.querySelectorAll('.tablist .tab').forEach((tab, i) => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.tablist .tab').forEach(t => {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');

        document.querySelectorAll('.tabpanel').forEach((panel, j) => {
          panel.classList.toggle('is-active', j === i);
          panel.hidden = j !== i;
        });
      });
    });
  </script>
