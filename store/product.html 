<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Heritage Tote — Netsorna</title>
  <meta name="description" content="The Heritage Tote — hand-stitched full-grain leather tote bag. Made to order.">
