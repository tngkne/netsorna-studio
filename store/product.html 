  <link rel="stylesheet" href="css/reset.css">
  <link rel="stylesheet" href="css/base.css">
  <style>
    /* ==========================================
       PRODUCT DETAIL PAGE
       ========================================== */

    .product-page {
      padding-top: calc(64px + var(--space-8));
      max-width: var(--content-max-width);
      margin: 0 auto;
      padding-left: var(--page-padding-x);
      padding-right: var(--page-padding-x);
    }

    .product-detail {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-12);
      padding-bottom: var(--section-gap);
    }

    @media (min-width: 1024px) {
      .product-detail {
        grid-template-columns: 1fr 1fr;
        gap: var(--space-16);
      }
    }

    /* Gallery */
    .gallery {
      position: sticky;
      top: calc(64px + var(--space-6));
      align-self: start;
    }

    .gallery__main {
      position: relative;
      aspect-ratio: 4 / 5;
      background: var(--hero-fallback);
      border-radius: var(--radius-lg);
      overflow: hidden;
      margin-bottom: var(--space-4);
    }

    .gallery__main img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .gallery__thumbs {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-3);
    }

    .gallery__thumb {
      aspect-ratio: 1;
      border-radius: var(--radius-md);
      overflow: hidden;
      cursor: pointer;
      border: 2px solid transparent;
      transition: border-color var(--duration-fast) var(--ease-smooth);
    }

    .gallery__thumb:hover,
    .gallery__thumb.is-active {
      border-color: var(--text-primary);
    }

    .gallery__thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Product Info */
    .product-info {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
    }

    .product-info__breadcrumbs {
      font-size: var(--text-sm);
      color: var(--text-muted);
    }

    .product-info__breadcrumbs a {
      transition: color var(--duration-fast) var(--ease-smooth);
    }

    .product-info__breadcrumbs a:hover {
      color: var(--text-primary);
    }

    .product-info__category {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: var(--tracking-widest);
      text-transform: uppercase;
      color: var(--text-muted);
    }

    .product-info__name {
      font-family: var(--font-secondary);
      font-size: var(--text-3xl);
      font-weight: var(--font-bold);
      color: var(--text-primary);
      line-height: var(--leading-tight);
    }

    .product-info__price-row {
      display: flex;
      align-items: baseline;
      gap: var(--space-3);
    }

    .product-info__price {
      font-family: var(--font-mono);
      font-size: var(--text-2xl);
      font-weight: var(--font-bold);
      color: var(--price-color);
    }

    .product-info__price--sale {
      color: var(--price-sale);
    }

    .product-info__price--original {
      font-size: var(--text-lg);
      color: var(--price-original);
      text-decoration: line-through;
      font-weight: var(--font-regular);
    }

    .product-info__stock {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: var(--text-sm);
    }

    .product-info__stock-dot {
      width: 8px;
      height: 8px;
      border-radius: var(--radius-full);
      background: var(--stock-available);
    }

    .product-info__desc {
      font-size: var(--text-base);
      color: var(--text-muted);
      line-height: var(--leading-relaxed);
    }

    /* Variants */
    .variant-group {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }

    .variant-group__label {
      font-size: var(--text-sm);
      font-weight: var(--font-semibold);
      color: var(--text-primary);
    }

    .variant-options {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    .variant-option {
      min-width: 44px;
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 var(--space-4);
      border: var(--border-default) solid var(--border-default);
      border-radius: var(--radius-md);
      font-size: var(--text-sm);
      font-weight: var(--font-medium);
      color: var(--text-primary);
      cursor: pointer;
      transition: all var(--duration-fast) var(--ease-smooth);
      background: var(--bg-surface);
    }

    .variant-option:hover {
      border-color: var(--text-primary);
    }

    .variant-option.is-active {
      border-color: var(--text-primary);
      background: var(--text-primary);
      color: var(--text-inverse);
    }

    .variant-option--color {
      width: 36px;
      height: 36px;
      min-width: auto;
      padding: 0;
      border-radius: var(--radius-full);
      border-width: 2px;
    }

    .variant-option--color.is-active {
      box-shadow: 0 0 0 2px var(--bg-surface), 0 0 0 4px var(--text-primary);
      background: inherit;
    }

    /* Quantity & Add to Cart */
    .product-actions {
      display: flex;
      gap: var(--space-4);
      padding-top: var(--space-4);
      border-top: var(--border-default) solid var(--border-light);
    }

    .quantity {
      display: flex;
      align-items: center;
      border: var(--border-default) solid var(--border-default);
      border-radius: var(--radius-md);
      overflow: hidden;
    }

    .quantity__btn {
      width: 44px;
      height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: var(--text-lg);
      color: var(--text-muted);
      transition: background var(--duration-fast) var(--ease-smooth);
    }

    .quantity__btn:hover {
      background: var(--bg-surface-alt);
    }

    .quantity__input {
      width: 48px;
      height: 48px;
      text-align: center;
      font-family: var(--font-mono);
      font-size: var(--text-base);
      font-weight: var(--font-semibold);
      border: none;
      border-left: var(--border-default) solid var(--border-default);
      border-right: var(--border-default) solid var(--border-default);
      -moz-appearance: textfield;
    }

    .quantity__input::-webkit-inner-spin-button,
    .quantity__input::-webkit-outer-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }

    .product-actions .btn--solid {
      flex: 1;
    }

    /* Product Meta */
    .product-meta {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      padding-top: var(--space-4);
      font-size: var(--text-sm);
      color: var(--text-muted);
    }

    .product-meta__item {
      display: flex;
      gap: var(--space-2);
    }

    .product-meta__label {
      font-weight: var(--font-medium);
      color: var(--text-primary);
    }

    /* Tabs */
    .product-tabs {
      padding: var(--section-gap) 0;
      border-top: var(--border-default) solid var(--border-light);
    }

    .tablist {
      display: flex;
      gap: var(--space-1);
      border-bottom: var(--border-default) solid var(--border-light);
      margin-bottom: var(--space-8);
    }

    .tab {
      padding: var(--space-3) var(--space-5);
      font-size: var(--text-sm);
      font-weight: var(--font-medium);
      color: var(--text-muted);
      border-bottom: 2px solid transparent;
      margin-bottom: -1px;
      transition: all var(--duration-fast) var(--ease-smooth);
      cursor: pointer;
      background: none;
    }

    .tab:hover {
      color: var(--text-primary);
    }

    .tab.is-active {
      color: var(--text-primary);
      border-bottom-color: var(--text-primary);
    }

    .tabpanel {
      display: none;
    }

    .tabpanel.is-active {
      display: block;
    }

    .tabpanel h3 {
      font-size: var(--text-lg);
      font-weight: var(--font-semibold);
      color: var(--text-primary);
      margin-bottom: var(--space-4);
    }

    .tabpanel p {
      font-size: var(--text-base);
      color: var(--text-muted);
      line-height: var(--leading-relaxed);
      margin-bottom: var(--space-4);
    }

    .tabpanel ul {
      list-style: disc;
      padding-left: var(--space-6);
      color: var(--text-muted);
      line-height: var(--leading-relaxed);
    }

    .tabpanel li {
      margin-bottom: var(--space-2);
    }

    /* Related Products */
    .related {
      padding: var(--section-gap) 0;
      border-top: var(--border-default) solid var(--border-light);
    }

    .related__title {
      font-family: var(--font-secondary);
      font-size: var(--text-2xl);
      font-weight: var(--font-bold);
      color: var(--text-primary);
      margin-bottom: var(--space-8);
    }

    .related__grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--grid-gutter);
    }

    @media (min-width: 640px) {
      .related__grid { grid-template-columns: repeat(4, 1fr); }
    }
  </style>
