  <style>
    /* ==========================================
       SHOP PAGE
       ========================================== */

    .page-header {
      padding: calc(64px + var(--space-16)) var(--page-padding-x) var(--space-12);
      text-align: center;
      background: linear-gradient(180deg, var(--bg-surface-alt) 0%, var(--bg-body) 100%);
    }

    .page-header__title {
      font-family: var(--font-secondary);
      font-size: var(--text-4xl);
      font-weight: var(--font-bold);
      color: var(--text-primary);
      margin-bottom: var(--space-3);
    }

    .page-header__count {
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      color: var(--text-muted);
    }

    /* Shop Layout */
    .shop {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-8);
      padding: 0 var(--page-padding-x) var(--section-gap);
      max-width: var(--content-max-width);
      margin: 0 auto;
    }

    @media (min-width: 1024px) {
      .shop {
        grid-template-columns: 240px 1fr;
        gap: var(--space-12);
      }
    }

    /* Filters Sidebar */
    .filters {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
    }

    @media (max-width: 1023px) {
      .filters {
        flex-direction: row;
        flex-wrap: wrap;
        gap: var(--space-3);
      }
      .filter-group { flex: 1; min-width: 140px; }
    }

    .filter-group__title {
      font-size: var(--text-sm);
      font-weight: var(--font-semibold);
      color: var(--text-primary);
      margin-bottom: var(--space-3);
      letter-spacing: var(--tracking-wide);
      text-transform: uppercase;
    }

    .filter-option {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      padding: var(--space-2) 0;
      font-size: var(--text-sm);
      color: var(--text-muted);
      cursor: pointer;
      transition: color var(--duration-fast) var(--ease-smooth);
    }

    .filter-option:hover,
    .filter-option.is-active {
      color: var(--text-primary);
    }

    .filter-option input[type="checkbox"] {
      width: 16px;
      height: 16px;
      accent-color: var(--text-primary);
    }

    .filter-option__count {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      color: var(--text-placeholder);
      margin-left: auto;
    }

    /* Sort Bar */
    .sort-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: var(--space-4);
      border-bottom: var(--border-default) solid var(--border-light);
      margin-bottom: var(--space-6);
    }

    .sort-bar__label {
      font-size: var(--text-sm);
      color: var(--text-muted);
    }

    .sort-bar__select {
      width: auto;
      min-width: 160px;
      padding: var(--space-2) var(--space-8) var(--space-2) var(--space-3);
      font-size: var(--text-sm);
    }

    /* Product Grid */
    .shop-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--grid-gutter);
    }

    @media (min-width: 640px) {
      .shop-grid { grid-template-columns: repeat(3, 1fr); }
    }

    .shop-grid .product-card__media { aspect-ratio: 3 / 4; }

    /* Pagination */
    .pagination {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-2);
      margin-top: var(--space-12);
      padding-top: var(--space-8);
      border-top: var(--border-default) solid var(--border-light);
    }

    .pagination__btn {
      min-width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: var(--radius-md);
      font-size: var(--text-sm);
      font-weight: var(--font-medium);
      color: var(--text-muted);
      transition: all var(--duration-fast) var(--ease-smooth);
    }

    .pagination__btn:hover {
      background: var(--bg-surface-alt);
      color: var(--text-primary);
    }

    .pagination__btn.is-active {
      background: var(--text-primary);
      color: var(--text-inverse);
    }

    .pagination__btn:disabled {
      opacity: 0.3;
      cursor: not-allowed;
    }
  </style>
